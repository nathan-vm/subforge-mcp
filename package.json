{
  "name": "subforge-mcp",
  "version": "1.3.1",
  "description": "MCP server for local LM Studio models",
  "type": "module",
  "license": "MIT",
  "author": "Nathan Marcelino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathan-vm/subforge-mcp.git"
  },
  "homepage": "https://github.com/nathan-vm/subforge-mcp#readme",
  "bugs": {
    "url": "https://github.com/nathan-vm/subforge-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lm-studio",
    "llm"
  ],
  "bin": {
    "subforge-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test",
    "test:live": "SUBFORGE_LIVE_TESTS=1 node --test tests/decision-live.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@lmstudio/sdk": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  }
}
